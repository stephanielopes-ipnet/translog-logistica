# Configuração da API do portal TransLog.
# Sem arquivo .env, tudo funciona com os valores abaixo (pedidos de exemplo, sem arquivo externo).
# Para mudar algo: cp .env.example .env e ajuste. Vale para o pnpm dev e para o Docker.
# Variáveis vazias contam como não definidas; variáveis do ambiente têm prioridade sobre o .env.
# Valor inválido: a API não sobe e diz qual variável está errada.

# Porta da API
API_PORT=3333

# Origem dos pedidos no pnpm dev / pnpm start:
#   fixtures = 11 pedidos de exemplo que vêm no código (padrão)
#   file     = Silver em CSV, lida inteira ao subir, ~10 s (exige ORDERS_FILE)
# No Docker estas duas variáveis não valem: a fonte é escolhida pelo COMPOSE_FILE abaixo.
DATA_SOURCE=fixtures

# Caminho do CSV da Silver, obrigatório com DATA_SOURCE=file.
# Caminho relativo parte da pasta portal/. O arquivo nunca vai para o Git nem para a imagem Docker.
# Ex.: ORDERS_FILE=dados/silver_pedidos_rastreio.csv
ORDERS_FILE=

# Docker com a Silver (portal/dados/silver_pedidos_rastreio.csv): descomente para o
# "docker compose up" usar também a sobreposição que monta a pasta dados/ como volume.
# COMPOSE_FILE=docker-compose.yml:docker-compose.silver.yml

# Pedidos de exemplo da tela (chips), separados por vírgula, na ordem de exibição.
# A API devolve só os que existirem na fonte.
SAMPLE_ORDER_IDS=15,375,562,1002

# Assistente do chat:
#   mock = respostas simuladas pela própria API, sem IA (padrão; funciona sem nada além do portal)
#   adk  = agente de IA do Marco (Google ADK + Gemini), que precisa estar no ar em AGENT_URL
# No Docker vale sempre mock (ver README): dentro do container, 127.0.0.1 é o próprio container.
AGENT=mock

# Endereço do agente, obrigatório com AGENT=adk. Em desenvolvimento: http://127.0.0.1:8001
# A chave do Gemini fica só no .env do agente, nunca aqui.
AGENT_URL=

# Nome do app no ADK (padrão translog_agent).
AGENT_APP_NAME=translog_agent

# Tempo máximo de espera por uma resposta do agente, em milissegundos (1000 a 600000).
# Padrão 90000 (90 s): o agente já levou 54 s numa pergunta. Depois disso a tela mostra
# "O assistente demorou demais".
AGENT_TIMEOUT_MS=90000

# Opcional: formato do log da API. production = JSON; ausente = legível.
# O Docker já usa production; em desenvolvimento, deixe comentado.
# NODE_ENV=production
