# Configuração da API do portal TransLog.
# Sem arquivo .env, tudo funciona com os valores abaixo (pedidos de exemplo, sem arquivo externo).
# Para mudar algo: cp .env.example .env e ajuste. Vale para o pnpm dev e para o Docker.
# Variáveis vazias contam como não definidas; variáveis do ambiente têm prioridade sobre o .env.
# Valor inválido: a API não sobe e diz qual variável está errada.

# Porta da API
API_PORT=3333

# Origem dos pedidos no pnpm dev / pnpm start:
#   fixtures   = 9 pedidos da demo que vêm no código (padrão)
#   file       = tabelas consumo_* em CSV na pasta DATA_DIR, lidas inteiras ao subir (~13 s)
#   databricks = tabelas consumo_* lidas do Databricks ao subir (~25 a 40 s com o warehouse
#                acordado; até 3 min se ele estiver dormindo). Exige as DATABRICKS_* abaixo.
#                Se falhar, a API não sobe e sugere DATA_SOURCE=file (plano B).
# No Docker estas duas variáveis não valem: a fonte é escolhida pelo COMPOSE_FILE abaixo.
DATA_SOURCE=fixtures

# Pasta com consumo_pedidos.csv, consumo_itens_pedido.csv e consumo_eventos_logisticos.csv
# (DATA_SOURCE=file e pnpm export:dados). Caminho relativo parte da pasta portal/.
# Os CSVs nunca vão para o Git nem para a imagem Docker.
DATA_DIR=dados

# Docker: por padrão, "docker compose up" usa os pedidos de exemplo. Descomente UMA linha:
#   com os CSVs de portal/dados/ (monta a pasta como volume somente leitura):
# COMPOSE_FILE=docker-compose.yml:docker-compose.dados.yml
#   direto do Databricks (credenciais DATABRICKS_* abaixo, passadas como variáveis de ambiente):
# COMPOSE_FILE=docker-compose.yml:docker-compose.databricks.yml

# Pedidos de exemplo da tela (chips), separados por vírgula, na ordem de exibição.
# A API devolve só os que existirem na fonte.
SAMPLE_ORDER_IDS=76902,375,34,8

# Databricks (tabelas workspace.silver.consumo_*): obrigatórias com DATA_SOURCE=databricks e
# usadas por "pnpm export:dados" para atualizar os CSVs de DATA_DIR. Preencha só no
# portal/.env (fora do Git); o token nunca vai para o código, os logs, os testes nem a imagem.
#   DATABRICKS_HOST: host do workspace, sem https:// (como aparece no painel)
#   DATABRICKS_WAREHOUSE_ID: id do SQL warehouse (final do HTTP path /sql/1.0/warehouses/<id>)
#   DATABRICKS_TOKEN: token de acesso pessoal (nunca aparece nas mensagens de erro)
#   DATABRICKS_CATALOG_SCHEMA: catálogo.schema das tabelas (padrão workspace.silver)
# DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=
# DATABRICKS_TOKEN=
# DATABRICKS_CATALOG_SCHEMA=workspace.silver

# Assistente do chat:
#   mock = respostas simuladas pela própria API, sem IA (padrão; funciona sem nada além do portal)
#   adk  = agente de IA do Marco (Google ADK + Gemini), que precisa estar no ar em AGENT_URL
# No Docker vale sempre mock (ver README): dentro do container, 127.0.0.1 é o próprio container.
AGENT=mock

# Endereço do agente, obrigatório com AGENT=adk. Em desenvolvimento: http://127.0.0.1:8001
# A chave do Gemini fica só no .env do agente, nunca aqui.
AGENT_URL=

# Nome do app no ADK (padrão translog_agent).
AGENT_APP_NAME=translog_agent

# Tempo máximo de espera por uma resposta do agente, em milissegundos (1000 a 600000).
# Padrão 90000 (90 s): o agente já levou 54 s numa pergunta. Depois disso a tela mostra
# "O assistente demorou demais".
AGENT_TIMEOUT_MS=90000

# Databricks: de quantos em quantos minutos a API confere se as tabelas mudaram (e recarrega, se mudaram).
# Padrão 10; 0 = só ao subir. Só vale com DATA_SOURCE=databricks.
# DATABRICKS_REFRESH_MINUTES=10
# Opcional: formato do log da API. production = JSON; ausente = legível.
# O Docker já usa production; em desenvolvimento, deixe comentado.
# NODE_ENV=production

# Área do colaborador (login). Sem STAFF_USERS e sem AUTH_DEMO, ninguém entra.
# Usuários: lista email:hash separada por vírgula. Gere cada linha com:
#   pnpm staff:add ana@translog.com      (pede a senha sem mostrar e imprime a linha)
# STAFF_USERS=
# Segredo que assina o cookie de sessão (pelo menos 32 caracteres; obrigatório com
# STAFF_USERS ou AUTH_DEMO=true). Gere com: openssl rand -base64 48
# SESSION_SECRET=
# Entrada rápida "Entrar como demonstração" (usuário demo@translog.local), só para o
# desenvolvimento e a banca. Padrão false: sem ela, a rota POST /api/auth/demo nem existe.
# AUTH_DEMO=false
# Tela compilada (web/dist): quando definida, a API serve a tela na mesma porta. A imagem do Docker
# já define WEB_DIR=web/dist; no pnpm dev deixe vazio (o Vite serve a tela em :5173).
# Se definir, rode "pnpm build" antes. Caminho relativo parte da pasta portal/.
# WEB_DIR=web/dist
