{
  "name": "translog-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --if-present dev",
    "start": "pnpm --filter @translog/api start",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "export:dados": "pnpm --filter @translog/api export:dados",
    "agent:up": "docker compose -f docker-compose.yml -f docker-compose.agente.yml up -d --build --wait agent",
    "agent:down": "docker compose -f docker-compose.yml -f docker-compose.agente.yml rm --stop --force agent"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
