# Copie para .env na raiz. Nunca publique a chave.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CSV é desenvolvimento. Banco definitivo aguarda o grupo.
# Valores: csv ou sql_pending. Não há fallback automático entre fontes.
TRANSLOG_ORDER_BACKEND=csv
TRANSLOG_ORDERS_CSV=data/samples/orders.csv
TRANSLOG_DATA_ORIGIN=sample
TRANSLOG_CSV_ENCODING=utf-8-sig
TRANSLOG_CSV_DELIMITER=,
# Caminho opcional para JSON de mapeamento de colunas; veja contrato-dados.md.
TRANSLOG_COLUMN_MAP=

TRANSLOG_KNOWLEDGE_DIR=.state/chroma
# Só habilite true para testar políticas fictícias do diretório demo.
TRANSLOG_ALLOW_DEMO_KNOWLEDGE=false
TRANSLOG_MODEL_CACHE=.cache/models
